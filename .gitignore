# Local resume assets and generated files
resources/templates/latex/*
!resources/templates/latex/.gitkeep
resources/templates/source/*
!resources/templates/source/.gitkeep
resources/workspace/*
!resources/workspace/.gitkeep
resources/output/*
!resources/output/.gitkeep

# Private reference and inspiration material
inspiration/

# Generated model availability report
tests/model-summary.md

# LLM debug dumps (may contain resume / job-description content)
*_debug_llm_response.txt

# Generated service artifacts
backend/.generations/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Backend local runtime data (SQLite, generated artifacts)
backend/data/
backend/*.db
backend/*.db-*

# Local config (contains API keys)
scripts/config_local.py

# Environment (contains API keys)
.env

# macOS
.DS_Store

# Local agent workspace state
.codewhale/
.kilo/worktrees/
