# CareerHelper environment template.
#   cp .env.example .env      # .env is gitignored and never committed
#
# Only the API key is required for a live generation; everything else has a
# working default.

# --- LLM (OpenCode Go) ---
OPENCODE_GO_API_KEY=your-key-here
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_PROVIDER=opencode
# LLM_MODEL=deepseek-v4-pro
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=32000

# Other providers (optional, selected via LLM_PROVIDER)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- LaTeX ---
# A name or an absolute path. When the engine is not on PATH it is
# auto-discovered in /Library/TeX/texbin and other common TeX locations.
# LATEX_ENGINE=/Library/TeX/texbin/pdflatex
# LATEX_RUNS=2
# LATEX_TIMEOUT=60
